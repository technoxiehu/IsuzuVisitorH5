<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.visitor.mapper.VisitorCompanionMapper">

    <resultMap type="VisitorCompanion" id="VisitorCompanionResult">
        <id     property="companionId"   column="companion_id"   />
        <result property="applicationId" column="application_id" />
        <result property="name"          column="name"           />
        <result property="idCard"        column="id_card"        />
        <result property="sortNo"        column="sort_no"        />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <!-- 批量插入（申请单提交时，唯一键 uk_application_id_card 兜底去重） -->
    <insert id="insertBatch">
        insert into visitor_companion(companion_id, application_id, name, id_card, sort_no, create_time)
        values
        <foreach collection="list" item="c" separator=",">
            (#{c.companionId}, #{c.applicationId}, #{c.name}, #{c.idCard}, #{c.sortNo}, #{c.createTime})
        </foreach>
    </insert>

    <!-- 按申请单号集合批量查询，列表/详情带出名单 -->
    <select id="selectListByApplicationIds" resultMap="VisitorCompanionResult">
        select companion_id, application_id, name, id_card, sort_no, create_time
        from visitor_companion
        where application_id in
        <foreach collection="applicationIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        order by application_id, sort_no
    </select>

</mapper>
